{
  "manifest_version": 3,
  "key": "",
  "name": "Kotilo New Tab",
  "short_name": "New Tab",
  "version": "3.0.0",
  "description": "Bookmarks sidebar, weather, calendar, to-dos, notes, news, Pomodoro and exchange rates on every new tab. No tracking.",
  "homepage_url": "https://kotilo.dev",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "geolocation",
    "sessions",
    "tabs",
    "topSites",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://date.nager.at/*",
    "https://www.brainyquote.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.currency-api.pages.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
